@page "/"
@page "/digimon"
@rendermode InteractiveServer
@using DigiDex.Web.Options
@using DigiDex.Web.Services
@using Microsoft.Extensions.Options
@inject IDigiApiClient DigiApiClient
@inject IOptions<DigiApiOptions> Options

<PageTitle>Digimon - DigiDex</PageTitle>

<div class="page-header">
    <div class="hero-copy">
        <p class="eyebrow">DigiDex</p>
        <h1>Digimon</h1>
        <p class="hero-subtitle">Enciclopedia visual para recorrer Digimon, evoluciones y detalles.</p>
    </div>
    <div class="hero-metrics" aria-label="Resumen del listado">
        <div class="metric-card">
            <span>Resultados</span>
            <strong>@TotalResultsLabel</strong>
        </div>
        <div class="metric-card metric-card-accent">
            <span>Vista</span>
            <strong>@CurrentModeLabel</strong>
        </div>
    </div>
</div>

<section class="toolbar">
    <DigimonSearchBox Value="@_searchTerm" OnSearch="SearchAsync" />

    <DigimonFilters LevelOptions="@_levelOptions"
                    AttributeOptions="@_attributeOptions"
                    SelectedLevel="@_selectedLevel"
                    SelectedAttribute="@_selectedAttribute"
                    SelectedXAntibody="@_selectedXAntibody"
                    IsLoading="@_areFilterOptionsLoading"
                    ErrorMessage="@_filterOptionsErrorMessage"
                    OnLevelChanged="ChangeLevelAsync"
                    OnAttributeChanged="ChangeAttributeAsync"
                    OnXAntibodyChanged="ChangeXAntibodyAsync"
                    OnClearFilters="ClearFiltersAsync" />

    <div class="view-control">
        <span class="control-label">Vista</span>
        <div class="view-toggle" aria-label="Modo de vista">
            <button class="@GetModeButtonClass(ListDisplayMode.Cards)" type="button" @onclick="() => ChangeModeAsync(ListDisplayMode.Cards)">
                Tarjetas
            </button>
            <button class="@GetModeButtonClass(ListDisplayMode.FullList)" type="button" @onclick="() => ChangeModeAsync(ListDisplayMode.FullList)">
                Lista completa
            </button>
        </div>
    </div>
</section>

@if (_isLoading)
{
    <LoadingSpinner Message="@LoadingMessage" />
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <ErrorMessage Message="_errorMessage" />
}
else if (!HasResults)
{
    <EmptyState Title="No hay Digimon" Message="No se encontraron Digimon con los criterios actuales." />
}
else if (_displayMode == ListDisplayMode.FullList)
{
    <div class="list-summary">
        <span>@_allDigimon.Count Digimon cargados</span>
        <span>Ordenados por ID</span>
    </div>

    <DigimonFullList Items="_allDigimon" />
}
else
{
    <div class="list-summary">
        <span>Pagina @(_digimonPage!.CurrentPage + 1) de @Math.Max(_digimonPage.TotalPages, 1)</span>
        <span>@_digimonPage.TotalElements resultados</span>
    </div>

    <DigimonGrid Items="_digimonPage.Items" />

    <nav class="pagination-bar" aria-label="Paginacion de Digimon">
        <button class="btn btn-secondary" type="button" @onclick="PreviousPageAsync" disabled="@(!_digimonPage.HasPreviousPage || _isLoading)">
            Anterior
        </button>
        <span>Pagina @(_digimonPage.CurrentPage + 1)</span>
        <button class="btn btn-secondary" type="button" @onclick="NextPageAsync" disabled="@(!_digimonPage.HasNextPage || _isLoading)">
            Siguiente
        </button>
    </nav>
}

@code {
    private DigimonListViewModel? _digimonPage;
    private bool _isLoading;
    private string? _errorMessage;
    private string? _searchTerm;
    private string? _selectedLevel;
    private string? _selectedAttribute;
    private bool? _selectedXAntibody;
    private bool _areFilterOptionsLoading;
    private string? _filterOptionsErrorMessage;
    private int _currentPage;
    private int _loadVersion;
    private ListDisplayMode _displayMode = ListDisplayMode.Cards;
    private IReadOnlyList<DigimonSummaryViewModel> _allDigimon = [];
    private IReadOnlyList<DigimonFilterOptionViewModel> _levelOptions = [];
    private IReadOnlyList<DigimonFilterOptionViewModel> _attributeOptions = [];

    private int PageSize => Options.Value.DefaultPageSize;

    private bool HasResults => _displayMode == ListDisplayMode.FullList
        ? _allDigimon.Count > 0
        : _digimonPage?.HasItems is true;

    private string LoadingMessage => _displayMode == ListDisplayMode.FullList
        ? "Cargando lista completa de Digimon..."
        : "Cargando Digimon...";

    private string TotalResultsLabel => _displayMode == ListDisplayMode.FullList
        ? _allDigimon.Count.ToString()
        : (_digimonPage?.TotalElements ?? 0).ToString();

    private string CurrentModeLabel => _displayMode == ListDisplayMode.FullList ? "Lista" : "Tarjetas";

    protected override async Task OnInitializedAsync()
    {
        await LoadFilterOptionsAsync();
        await LoadCurrentModeAsync();
    }

    private async Task SearchAsync(string? term)
    {
        var normalizedTerm = string.IsNullOrWhiteSpace(term) ? null : term.Trim();

        if (string.Equals(_searchTerm, normalizedTerm, StringComparison.Ordinal))
        {
            return;
        }

        _searchTerm = normalizedTerm;
        _currentPage = 0;
        await LoadCurrentModeAsync();
    }

    private Task ChangeLevelAsync(string? level)
    {
        return ChangeFiltersAsync(level, _selectedAttribute, _selectedXAntibody);
    }

    private Task ChangeAttributeAsync(string? attribute)
    {
        return ChangeFiltersAsync(_selectedLevel, attribute, _selectedXAntibody);
    }

    private Task ChangeXAntibodyAsync(bool? xAntibody)
    {
        return ChangeFiltersAsync(_selectedLevel, _selectedAttribute, xAntibody);
    }

    private Task ClearFiltersAsync()
    {
        return ChangeFiltersAsync(null, null, null);
    }

    private async Task ChangeFiltersAsync(string? level, string? attribute, bool? xAntibody)
    {
        var normalizedLevel = NormalizeFilter(level);
        var normalizedAttribute = NormalizeFilter(attribute);

        if (string.Equals(_selectedLevel, normalizedLevel, StringComparison.Ordinal)
            && string.Equals(_selectedAttribute, normalizedAttribute, StringComparison.Ordinal)
            && _selectedXAntibody == xAntibody)
        {
            return;
        }

        _selectedLevel = normalizedLevel;
        _selectedAttribute = normalizedAttribute;
        _selectedXAntibody = xAntibody;
        _currentPage = 0;

        await LoadCurrentModeAsync();
    }

    private Task PreviousPageAsync()
    {
        return LoadPageAsync(Math.Max(_currentPage - 1, 0));
    }

    private Task NextPageAsync()
    {
        return LoadPageAsync(_currentPage + 1);
    }

    private async Task ChangeModeAsync(ListDisplayMode mode)
    {
        if (_displayMode == mode)
        {
            return;
        }

        _displayMode = mode;
        await LoadCurrentModeAsync();
    }

    private Task LoadCurrentModeAsync()
    {
        return _displayMode == ListDisplayMode.FullList
            ? LoadAllAsync()
            : LoadPageAsync(_currentPage);
    }

    private async Task LoadFilterOptionsAsync()
    {
        _areFilterOptionsLoading = true;
        _filterOptionsErrorMessage = null;

        try
        {
            var levelOptionsTask = DigiApiClient.GetLevelOptionsAsync();
            var attributeOptionsTask = DigiApiClient.GetAttributeOptionsAsync();

            _levelOptions = await levelOptionsTask;
            _attributeOptions = await attributeOptionsTask;
        }
        catch (DigiApiException exception)
        {
            _levelOptions = [];
            _attributeOptions = [];
            _filterOptionsErrorMessage = exception.Message;
        }
        catch
        {
            _levelOptions = [];
            _attributeOptions = [];
            _filterOptionsErrorMessage = "No se pudieron cargar las opciones de filtro. Intentalo de nuevo.";
        }
        finally
        {
            _areFilterOptionsLoading = false;
        }
    }

    private async Task LoadPageAsync(int page)
    {
        var loadVersion = ++_loadVersion;
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var digimonPage = await DigiApiClient.GetDigimonPageAsync(
                page,
                PageSize,
                _searchTerm,
                _selectedLevel,
                _selectedAttribute,
                _selectedXAntibody);

            if (loadVersion != _loadVersion)
            {
                return;
            }

            _digimonPage = digimonPage;
            _currentPage = _digimonPage.CurrentPage;
            _allDigimon = [];
        }
        catch (DigiApiException exception)
        {
            if (loadVersion != _loadVersion)
            {
                return;
            }

            _digimonPage = null;
            _errorMessage = exception.Message;
        }
        catch
        {
            if (loadVersion != _loadVersion)
            {
                return;
            }

            _digimonPage = null;
            _errorMessage = "No se pudieron cargar los Digimon. Intentalo de nuevo.";
        }
        finally
        {
            if (loadVersion == _loadVersion)
            {
                _isLoading = false;
            }
        }
    }

    private async Task LoadAllAsync()
    {
        var loadVersion = ++_loadVersion;
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var allDigimon = await DigiApiClient.GetAllDigimonAsync(
                _searchTerm,
                _selectedLevel,
                _selectedAttribute,
                _selectedXAntibody);

            if (loadVersion != _loadVersion)
            {
                return;
            }

            _allDigimon = allDigimon;
            _digimonPage = null;
        }
        catch (DigiApiException exception)
        {
            if (loadVersion != _loadVersion)
            {
                return;
            }

            _allDigimon = [];
            _errorMessage = exception.Message;
        }
        catch
        {
            if (loadVersion != _loadVersion)
            {
                return;
            }

            _allDigimon = [];
            _errorMessage = "No se pudo cargar la lista completa de Digimon. Intentalo de nuevo.";
        }
        finally
        {
            if (loadVersion == _loadVersion)
            {
                _isLoading = false;
            }
        }
    }

    private string GetModeButtonClass(ListDisplayMode mode)
    {
        return _displayMode == mode ? "mode-button active" : "mode-button";
    }

    private static string? NormalizeFilter(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    }

    private enum ListDisplayMode
    {
        Cards,
        FullList
    }
}
